# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Codex (used instead of Anthropic when LLM_PROVIDER=codex)
LLM_PROVIDER=anthropic
CODEX_API_KEY=
CODEX_BASE_URL=https://api.openai.com/v1
# gpt-5-codex is deprecated on some keys; gpt-5.5 is confirmed working.
CODEX_MODEL=gpt-5.5

# Supabase — Project Settings -> API for these three
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Hackathon MVP: one hardcoded patient, no auth model at all.
PATIENT_ID=00000000-0000-0000-0000-000000000001
