# ElevenLabs — Scribe transcribes the visit; an Agent runs the voice check-ins.
# ELEVENLABS_AGENT_ID is optional: leave it blank and /api/checkin/session
# returns 503, so the UI falls back to the check-in form. Create the agent in
# the ElevenLabs dashboard and give its prompt these dynamic variables, which
# /api/checkin/session supplies per call:
#   {{interval_brief}} {{plan_brief}} {{week}} {{condition_name}}
#   {{plain_name}} {{is_first_check_in}} {{framing_rule}}
#   {{prohibited_outputs}} {{red_flag_lines}}
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Codex (used instead of Anthropic when LLM_PROVIDER=codex)
LLM_PROVIDER=anthropic
CODEX_API_KEY=
CODEX_BASE_URL=https://api.openai.com/v1
# gpt-5-codex is deprecated on some keys; gpt-5.5 is confirmed working.
CODEX_MODEL=gpt-5.5

# Supabase — Project Settings -> API for these three
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Django — also signs patient auth tokens (see backend/loop/auth.py). Do not
# leave this empty: an unset value falls back to a hardcoded, publicly visible
# dev string, which would let anyone forge a valid login for any patient.
# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Legacy hackathon demo patient, predating real accounts. Still used by the
# seed_demo* management commands; real users sign up/in instead.
PATIENT_ID=00000000-0000-0000-0000-000000000001
